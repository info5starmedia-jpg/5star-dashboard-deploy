# codes-bot configuration — copy to .env for local testing.
# In production these are stored as GitHub Actions Secrets (never committed).

# ── Gmail (one entry per inbox; App Passwords, NOT your login password) ────────
# Generate at: Google Account → Security → 2-Step Verification → App passwords
GMAIL_ACCOUNTS=[{"user":"one@gmail.com","appPassword":"xxxx xxxx xxxx xxxx"},{"user":"two@gmail.com","appPassword":"yyyy yyyy yyyy yyyy"}]

# From-address substrings to keep (comma-separated). Default: seated.com
SENDERS=seated.com

# ── AYCD Inbox API ────────────────────────────────────────────────────────────
AYCD_INBOX_TOKEN=
# Optional overrides (defaults are sensible; confirm against your AYCD account):
# AYCD_INBOX_BASE_URL=https://api.useinbox.com
# AYCD_INBOX_MAIL_PATH=/v1/mail

# ── Google Sheet (the master sheet that syncs to your desktop via Drive) ───────
SHEET_ID=
SHEET_TAB=Codes
# Paste the entire service-account JSON key on one line:
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Tuning ────────────────────────────────────────────────────────────────────
LOOKBACK_DAYS=30
