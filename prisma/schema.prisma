generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  role        String   @default("user") // "user" | "admin" | "promoter"
  disabled    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastLoginAt DateTime?
}

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  targetEmail String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model Subscription {
  id                   String   @id @default(cuid())
  userEmail            String
  stripeCustomerId     String
  stripeSubscriptionId String   @unique
  priceId              String
  status               String
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userEmail])
  @@index([stripeCustomerId])
  @@index([status])
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())

  @@index([type])
}

model InventoryItem {
  id         String   @id @default(cuid())
  name       String
  subtitle   String?
  content    String?
  sku        String   @unique
  quantity   Int
  priceCents Int
  costCents  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([name])
}

model Invoice {
  id             String            @id @default(cuid())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdByEmail String
  customerEmail  String?
  status         String            @default("issued")
  subtotalCents  Int
  taxCents       Int               @default(0)
  totalCents     Int
  lineItems      InvoiceLineItem[]

  @@index([createdAt])
  @@index([customerEmail])
}

model InvoiceLineItem {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  sku            String?
  quantity       Int
  unitPriceCents Int
  totalCents     Int
  deliveredContent String?

  @@index([invoiceId])
}

model PromoCode {
  id                String           @id @default(cuid())
  code              String           @unique
  promoter          String
  discountType      String           // "percent" | "amount"
  discountValue     Int              // percent 1-100 OR cents
  isLifetime        Boolean          @default(false)
  expiresAt         DateTime?
  isActive          Boolean          @default(true)
  stripeCouponId    String?
  stripePromoId     String?
  totalUses         Int              @default(0)
  appliesToProducts String?
  totalRevenueCents Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  usages            PromoCodeUsage[]

  @@index([code])
  @@index([promoter])
  @@index([isActive])
}

model PromoCodeUsage {
  id            String    @id @default(cuid())
  promoCodeId   String
  promoCode     PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  code          String
  promoter      String
  customerEmail String
  orderId       String
  amountCents   Int
  createdAt     DateTime  @default(now())

  @@index([promoCodeId])
  @@index([promoter])
  @@index([customerEmail])
}
